{
	"schemaVersion": 1,
	"id": "mc-modvalidator-fabric",
	"version": "${version}",
	"name": "MC-Modvalidator-Fabric",
	"description": "Runtime diagnostics and autofix tool that scans loaded mods for Kotlin-interop and porting issues.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/mc-modvalidator-fabric/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "mcmodvalidator.pro.MCModvalidatorFabric",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "mcmodvalidator.pro.client.MCModvalidatorFabricClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "mcmodvalidator.pro.client.MCModvalidatorFabricDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"mc-modvalidator-fabric.mixins.json",
		{
			"config": "mc-modvalidator-fabric.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}